@page
@model LoginModel
@{
    ViewData["Title"] = "Ingresar";
    ViewData["AuthImage"] = "/img/services/skin-fade.jpg";
    Layout = "_AuthLayout";

    // El PageModel agrega "Invalid login attempt."; acá se muestra con el texto del diseño.
    const string invalidLoginServerMessage = "Invalid login attempt.";
    const string invalidLoginMessage = "Ese mail y esa contraseña no coinciden. Revisá la contraseña o creá una cuenta nueva.";
    var formErrors = ViewData.ModelState[string.Empty]?.Errors
        .Select(e => e.ErrorMessage == invalidLoginServerMessage ? invalidLoginMessage : e.ErrorMessage)
        .ToList() ?? new List<string>();
}

<h1 class="nf-h1-sm">Entrá para reservar</h1>
<p class="nf-lead">Con tu cuenta reservás, ves y cancelás tus turnos.</p>

<form id="account" method="post" novalidate>
    @if (formErrors.Any())
    {
        <div class="nf-alert" role="alert">
            @foreach (var error in formErrors)
            {
                <p>@error</p>
            }
        </div>
    }

    <div class="nf-auth__fields">
        <div class="nf-field">
            <label asp-for="Input.Email" class="nf-label">Mail</label>
            <input asp-for="Input.Email" class="nf-input" type="email" autocomplete="username" aria-describedby="Input_Email-error" />
            <span asp-validation-for="Input.Email" id="Input_Email-error" class="nf-error"></span>
        </div>

        <div class="nf-field">
            <label asp-for="Input.Password" class="nf-label">Contraseña</label>
            <input asp-for="Input.Password" class="nf-input" autocomplete="current-password" aria-describedby="Input_Password-error" />
            <span asp-validation-for="Input.Password" id="Input_Password-error" class="nf-error"></span>
        </div>

        <label class="nf-check">
            <input asp-for="Input.RememberMe" />
            Mantener la sesión abierta
        </label>
    </div>

    <button type="submit" class="nf-btn nf-btn--primary nf-btn--block">Ingresar</button>
</form>

<p class="nf-auth__switch">
    ¿Todavía no tenés cuenta?<a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Crear una cuenta</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
