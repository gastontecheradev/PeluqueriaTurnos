@page
@model RegisterModel
@{
    ViewData["Title"] = "Crear cuenta";
    ViewData["AuthImage"] = "/img/services/barba.jpg";
    Layout = "_AuthLayout";

    // Sin returnUrl, después de registrarse se va directo a reservar (coincide con "Crear cuenta y reservar").
    var returnUrl = Model.ReturnUrl ?? Url.Action("Create", "Appointments", new { area = "" });
}

<h1 class="nf-h1-sm">Crear cuenta</h1>
<p class="nf-lead">Con tu cuenta reservás en un minuto y ves todos tus turnos.</p>

<form id="registerForm" asp-route-returnUrl="@returnUrl" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="nf-alert" role="alert"></div>

    <div class="nf-auth__fields">
        <div class="nf-field">
            <label asp-for="Input.Email" class="nf-label">Mail</label>
            <input asp-for="Input.Email" class="nf-input" type="email" autocomplete="username" aria-required="true" aria-describedby="Input_Email-error" />
            <span asp-validation-for="Input.Email" id="Input_Email-error" class="nf-error"></span>
        </div>

        <div class="nf-field">
            <label asp-for="Input.Password" class="nf-label">Contraseña</label>
            <input asp-for="Input.Password" class="nf-input" autocomplete="new-password" aria-required="true" aria-describedby="Input_Password-help Input_Password-error" />
            <span class="nf-help" id="Input_Password-help">Mínimo 6 caracteres, con una mayúscula, una minúscula, un número y un símbolo.</span>
            <span asp-validation-for="Input.Password" id="Input_Password-error" class="nf-error"></span>
        </div>

        <div class="nf-field">
            <label asp-for="Input.ConfirmPassword" class="nf-label">Repetir contraseña</label>
            <input asp-for="Input.ConfirmPassword" class="nf-input" autocomplete="new-password" aria-required="true" aria-describedby="Input_ConfirmPassword-error" />
            <span asp-validation-for="Input.ConfirmPassword" id="Input_ConfirmPassword-error" class="nf-error"></span>
        </div>
    </div>

    <button id="registerSubmit" type="submit" class="nf-btn nf-btn--primary nf-btn--block">Crear cuenta y reservar</button>
</form>

<p class="nf-auth__switch">
    ¿Ya tenés cuenta?<a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Ingresar</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
