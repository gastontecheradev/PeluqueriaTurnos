@using Microsoft.AspNetCore.Identity
@using PeluqueriaTurnos.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="nf-account">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var displayName = !string.IsNullOrWhiteSpace(user?.FullName) ? user!.FullName : User.Identity?.Name;
        <span class="nf-account__name">@displayName</span>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@(Url.Action("Index", "Home"))" method="post">
            <button type="submit" class="nf-btn nf-btn--secondary nf-btn--logout">Cerrar sesión</button>
        </form>
    }
    else
    {
        <a class="nf-nav__link" asp-area="Identity" asp-page="/Account/Login">Ingresar</a>
        <a class="nf-btn nf-btn--primary nf-btn--header" asp-area="" asp-controller="Appointments" asp-action="Create">Reservar turno</a>
    }
</div>
