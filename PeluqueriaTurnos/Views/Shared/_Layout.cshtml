@using Microsoft.AspNetCore.Identity
@using PeluqueriaTurnos.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    var currentAction = ViewContext.RouteData.Values["action"] as string;

    string? AriaCurrent(string controller, string action) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            ? "page"
            : null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - NovaFade Studio</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin" />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/img/favicon.png">

    <!-- Open Graph -->
    <meta property="og:title" content="NovaFade" />
    <meta property="og:description" content="NovaFade Barberia" />
    <meta property="og:image" content="https://novafadestudio.somee.com/img/og-image.jpg" />
    <meta property="og:type" content="website" />
</head>
<body>
    <header class="nf-header" data-nf-header>
        <div class="nf-header__inner">
            <a class="nf-brand" asp-controller="Home" asp-action="Index">
                <span class="nf-brand__name">NovaFade</span>
                <span class="nf-brand__tagline">Peluquería &amp; barbería · Montevideo</span>
            </a>

            <button type="button" class="nf-btn nf-btn--secondary nf-btn--logout nf-nav-toggle"
                    aria-expanded="false" aria-controls="nf-nav" data-nf-nav-toggle>
                Menú
            </button>

            <nav class="nf-nav" id="nf-nav" aria-label="Principal">
                <ul class="nf-nav__links">
                    <li><a class="nf-nav__link" asp-controller="Home" asp-action="Index" aria-current="@AriaCurrent("Home", "Index")">Inicio</a></li>
                    <li><a class="nf-nav__link" asp-controller="Home" asp-action="About" aria-current="@AriaCurrent("Home", "About")">El Studio</a></li>
                    <li><a class="nf-nav__link" asp-controller="Home" asp-action="Contact" aria-current="@AriaCurrent("Home", "Contact")">Contacto</a></li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li><a class="nf-nav__link" asp-controller="Appointments" asp-action="Create" aria-current="@AriaCurrent("Appointments", "Create")">Reservar turno</a></li>
                        <li><a class="nf-nav__link" asp-controller="Appointments" asp-action="My" aria-current="@AriaCurrent("Appointments", "My")">Mis turnos</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li><a class="nf-nav__link" asp-controller="Appointments" asp-action="Index" aria-current="@AriaCurrent("Appointments", "Index")">Agenda</a></li>
                        }
                    }
                </ul>

                <partial name="_LoginPartial" />
            </nav>
        </div>
    </header>

    <main class="nf-main">
        @RenderBody()
    </main>

    <footer class="nf-footer">
        <div class="nf-container nf-footer__inner">
            <div>
                <div class="nf-footer__name">NovaFade Studio</div>
                <div class="nf-footer__meta">Montevideo, Uruguay · @DateTime.Now.Year</div>
            </div>
            <ul class="nf-footer__links">
                <li><a asp-controller="Home" asp-action="Contact">Agendá tu turno</a></li>
                <li><a href="#">Instagram</a></li>
                <li><a href="#">WhatsApp</a></li>
            </ul>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
