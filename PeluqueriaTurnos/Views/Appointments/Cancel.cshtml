@model PeluqueriaTurnos.Models.Appointment
@using System.Globalization
@{
    ViewData["Title"] = "Cancelar turno";
    var uy = CultureInfo.GetCultureInfo("es-UY");
    var when = Model.Start.ToString("dddd d 'de' MMMM, HH:mm", uy);
    when = char.ToUpper(when[0], uy) + when.Substring(1);
}

<div class="nf-cancel">
    <h1 class="nf-h1-sm">¿Cancelamos este turno?</h1>
    <p class="nf-lead">
        El horario queda libre para otra persona. Si querés venir otro día,
        podés reservar un turno nuevo cuando quieras.
    </p>

    <dl class="nf-dl nf-cancel__dl">
        <div class="nf-dl__row">
            <dt>Día y hora</dt>
            <dd>@when</dd>
        </div>
        <div class="nf-dl__row">
            <dt>Servicio</dt>
            <dd>@Model.Service.Name</dd>
        </div>
        <div class="nf-dl__row">
            <dt>Estilista</dt>
            <dd>@Model.Stylist.Name</dd>
        </div>
    </dl>

    <div class="nf-cancel__actions">
        <form asp-action="Cancel" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="nf-btn nf-btn--danger">Sí, cancelar el turno</button>
        </form>
        <a asp-action="My" class="nf-link">Volver a Mis turnos</a>
    </div>
</div>
