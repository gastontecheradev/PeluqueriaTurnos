@{
    ViewData["Title"] = "Contacto";
}

<div class="nf-container nf-page">
    <div class="nf-contact">
        <div>
            <h1 class="nf-h1">Contacto</h1>
            <p class="nf-lead">
                Escribinos por WhatsApp o mail para consultas especiales, cambios de turno
                o servicios para grupos.
            </p>

            <dl class="nf-dl nf-contact__dl">
                <div class="nf-dl__row">
                    <dt>Teléfono y WhatsApp</dt>
                    <dd>@ViewBag.Phone</dd>
                </div>
                <div class="nf-dl__row">
                    <dt>Mail</dt>
                    <dd>@ViewBag.Email</dd>
                </div>
                <div class="nf-dl__row">
                    <dt>Dónde estamos</dt>
                    <dd>@ViewBag.City</dd>
                </div>
            </dl>

            <a class="nf-btn nf-btn--primary" asp-controller="Appointments" asp-action="Create">Reservar turno online</a>
        </div>

        <iframe class="nf-map"
                title="Mapa de NovaFade Studio en Montevideo"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d26178.292757533938!2d-56.200348682232516!3d-34.89925667872407!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x959f80ffc63bf7d3%3A0x6b321b2e355bec99!2sMontevideo%2C%20Departamento%20de%20Montevideo!5e0!3m2!1ses!2suy!4v1765388308688!5m2!1ses!2suy"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
</div>
